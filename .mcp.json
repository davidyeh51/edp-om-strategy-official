{
  "mcpServers": {
    "lark-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@larksuiteoapi/lark-mcp@0.5.1",
        "mcp",
        "--domain",
        "https://open.larksuite.com",
        "--tools",
        "preset.default",
        "--language",
        "zh"
      ],
      "env": {
        "APP_ID": "${LARK_APP_ID}",
        "APP_SECRET": "${LARK_APP_SECRET}"
      }
    }
  }
}
